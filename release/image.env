# Release metadata for this branch, read by release/build-on-builder.sh and
# the release gate. Plain KEY=value lines only.
#
# 5.0.1-4 is an overlay release: the released 5.0.1-3 image with the files
# listed as gate_overlay_file replaced (see Dockerfile.release). The gate is
# release/verify-overlay.sh.
cylo_build_kind=overlay
cylo_build_repo_slug=eveseat-app
cylo_build_image=eveseat
cylo_build_tag=5.0.1-4
cylo_build_release_ref=repo.cylo.net/eveseat:5.0.1-4
cylo_build_dockerfile=Dockerfile.release
cylo_build_git_remote=origin
cylo_build_git_branch=seat-db-wait
cylo_build_gate=release/verify-overlay.sh
# The released image this one is built on (5.0.1-3).
gate_base_ref=repo.cylo.net/eveseat@sha256:57f8ee40267ae1ab29f39d1210c8812b5964e2a6ab926b5130731228cc331f76
# PHP must still be the release with the 21 October 2026 security fixes.
gate_php_release_version=8.2.35
# <committed file>:<path in the image>, one per COPY in Dockerfile.release.
gate_overlay_file=scripts/Entrypoint.sh:/entrypoint.sh
gate_overlay_file=rootfs/etc/cont-init.d/00-permissions:/etc/cont-init.d/00-permissions
