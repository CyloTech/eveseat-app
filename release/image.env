# Release metadata for this branch, read by release/build-on-builder.sh and
# release/verify-image.sh. Plain KEY=value lines only.
cylo_build_kind=official-php
cylo_build_repo_slug=eveseat-app
cylo_build_image=eveseat
cylo_build_tag=5.0.1-3
cylo_build_release_ref=repo.cylo.net/eveseat:5.0.1-3
cylo_build_dockerfile=Dockerfile.release
cylo_build_git_remote=origin
cylo_build_git_branch=php-multipart-fix
# The deployed image the release is built on (5.0.1-2).
gate_base_ref=repo.cylo.net/eveseat@sha256:f82edaddaea7fb7e41137ef37cf2bae5644c2c1f57f16044df35e7cbb9f7def2
# The PHP release that fixes the multipart/form-data bugs (21 October 2026).
gate_php_release_version=8.2.35
gate_php_image_pattern=php:8.2.35-fpm-bookworm
gate_php_extension_dir=/usr/local/lib/php/extensions/no-debug-non-zts-20220829
