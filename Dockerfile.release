# SeAT 5.0.1-3: the deployed 5.0.1-2 image (repo.cylo.net/eveseat:5.0.1-2)
# with PHP replaced by PHP 8.2.35, the release with the security fixes of
# 21 October 2026.
#
# 5.0.1-2 runs PHP 8.2.32 from the official php:8.2-fpm-bookworm image under
# /usr/local. The new PHP comes from
# repo.cylo.net/php-artifacts:docker-library-php-8.2.35-fpm-bookworm, a
# FROM-scratch artifact holding the /usr/local tree of PHP 8.2.35 built with
# the unmodified docker-library/php 8.2/bookworm/fpm recipe (the recipe behind
# the official image; see release/php-artifact/). Only the files PHP's own
# build installs there are copied in: the CLI and FPM binaries, php-config,
# phpize, the headers, the build files and the shared extensions the recipe
# ships (opcache, sodium). The extensions SeAT compiled for PHP 8.2 (same
# module API, 20220829), the PHP and FPM configuration in /usr/local/etc, and
# SeAT itself stay exactly as deployed.
#
# SEAT_IMAGE_VERSION and SEAT_IMAGE_REVISION are inherited unchanged on
# purpose: Entrypoint.sh uses the revision as its release marker, so 5.0.1-2
# installs do not re-apply the application tree when they move to 5.0.1-3.
#
# PHP_IMAGE is pinned by digest. A trial build may override PHP_VERSION and
# PHP_IMAGE with another PHP image (release/build-on-builder.sh trial).

ARG PHP_VERSION=8.2.35
ARG PHP_IMAGE=repo.cylo.net/php-artifacts:docker-library-php-8.2.35-fpm-bookworm@sha256:f67ca1157d92fef64753ff786b5d8010b281c805fba263f702afa495973d7edc
ARG PHP_EXTENSION_DIR=/usr/local/lib/php/extensions/no-debug-non-zts-20220829

FROM ${PHP_IMAGE} AS patched-php

FROM repo.cylo.net/eveseat@sha256:f82edaddaea7fb7e41137ef37cf2bae5644c2c1f57f16044df35e7cbb9f7def2
ARG PHP_VERSION
ARG PHP_IMAGE
ARG PHP_EXTENSION_DIR

COPY --from=patched-php /usr/local/bin/php /usr/local/bin/php-config /usr/local/bin/phpize /usr/local/bin/
COPY --from=patched-php /usr/local/sbin/php-fpm /usr/local/sbin/
COPY --from=patched-php /usr/local/include/php/ /usr/local/include/php/
COPY --from=patched-php /usr/local/lib/php/build/ /usr/local/lib/php/build/
COPY --from=patched-php ${PHP_EXTENSION_DIR}/ ${PHP_EXTENSION_DIR}/

ENV PHP_VERSION=${PHP_VERSION}
LABEL org.appbox.php-source=${PHP_IMAGE}
