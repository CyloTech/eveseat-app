# SeAT 5.0.1-4: the released 5.0.1-3 image (repo.cylo.net/eveseat:5.0.1-3,
# PHP 8.2.35) with two startup files replaced and nothing else changed.
#
# - /entrypoint.sh (scripts/Entrypoint.sh) waits up to
#   MYSQL_WAIT_TIMEOUT_SECONDS (default 900) for MariaDB instead of 180
#   seconds. The post-start Appbox callback keeps waiting for MariaDB, Redis
#   and the web server, up to CALLBACK_READY_TIMEOUT_SECONDS (default 3600),
#   instead of giving up for good when the first wait runs out.
# - /etc/cont-init.d/00-permissions only changes ownership that is wrong
#   instead of rewriting every inode under /home/appbox before the services
#   start.
#
# 5.0.1-3 itself was built by the previous version of this file (see the git
# history): the deployed 5.0.1-2 image with PHP 8.2.35 copied in.
# SEAT_IMAGE_VERSION and SEAT_IMAGE_REVISION are inherited unchanged, so
# instances on 5.0.1-2 or 5.0.1-3 do not re-apply the application tree.

FROM repo.cylo.net/eveseat@sha256:57f8ee40267ae1ab29f39d1210c8812b5964e2a6ab926b5130731228cc331f76

COPY --chmod=755 scripts/Entrypoint.sh /entrypoint.sh
COPY --chmod=755 rootfs/etc/cont-init.d/00-permissions /etc/cont-init.d/00-permissions
